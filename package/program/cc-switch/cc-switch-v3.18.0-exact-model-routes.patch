@@
 fn apply_local_proxy_body_overrides(
     body: &mut Value,
     overrides: &LocalProxyRequestOverrides,
+    original_request_model: Option<&str>,
 ) -> bool {
-    let Some(override_body) = overrides.body.as_ref() else {
-        return false;
-    };
-    if !override_body.is_object() {
-        log::warn!("[LocalProxyOverrides] Ignoring body override because it is not an object");
-        return false;
+    const EXACT_MODEL_ROUTES_FEATURE: &str = "cc-switch-local-proxy-exact-model-routes-v1";
+    let mut changed = false;
+    if let Some(override_body) = overrides.body.as_ref() {
+        if override_body.is_object() {
+            changed |= merge_json_override(body, override_body);
+        }
     }
-    merge_json_override(body, override_body)
+    if let Some(request_model) = original_request_model.map(str::trim) {
+        if let Some(upstream_model) = overrides.model_routes.get(request_model)
+            .map(String::as_str).map(str::trim).filter(|model| !model.is_empty())
+        {
+            if body.get("model").and_then(Value::as_str) != Some(upstream_model) {
+                log::debug!("[{EXACT_MODEL_ROUTES_FEATURE}] Exact model route: {request_model} -> {upstream_model}");
+                body["model"] = Value::String(upstream_model.to_string());
+                changed = true;
+            }
+        }
+    }
+    changed
 }
